# ==============================================================================
# ERP IOT INGESTION SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# This file documents environment variable names and development defaults.
# Real production secrets must be supplied via secure secret management.
# ==============================================================================

# Server port where erp-iot-ingestion listens
SERVER_PORT=8087

# Runtime environment (dev, staging, prod)
ENVIRONMENT=dev

# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Apache Kafka brokers (comma-separated host:port list)
KAFKA_BROKERS=localhost:9092

# Kafka raw telemetry topic name (partitioned by vehicle_id)
KAFKA_TELEMETRY_TOPIC=telemetry.raw

# Kafka dead-letter queue topic for corrupt/unparseable messages
KAFKA_DLQ_TOPIC=telemetry.dlq

# Kafka producer batching parameters (optimized for 2,000 msg/s bursts)
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT_MS=10
KAFKA_ASYNC=true

# Maximum allowed HTTP request body size in bytes (1MB default)
MAX_REQUEST_BODY_SIZE=1048576

# Graceful shutdown draining timeout in seconds
SHUTDOWN_TIMEOUT_SECONDS=10

# Pre-shared device authentication keys (deviceKey:tenantUUID comma-separated)
ALLOWED_DEVICE_KEYS=test-device-key:00000000-0000-0000-0000-000000000001
